#!/bin/sh
# /init  –  PID-1 for the testing initramfs
# Mounts all virtual filesystems, populates /dev via mdev, probes devices,
# prints a full system report, then drops to an interactive BusyBox shell.
# Every step is logged to /var/log/init.log as well as the console.
# =============================================================================

# ---------------------------------------------------------------------------
# 0. Very early setup – we have nothing yet, not even /proc
# ---------------------------------------------------------------------------
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mkdir -p /proc /sys /dev /tmp /var

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /dev   
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /var


mkdir -p /var/log /var/run

for node in \
    "null   c 1 3" \
    "zero   c 1 5" \
    "full   c 1 7" \
    "random c 1 8" \
    "urandom c 1 9" \
    "kmsg   c 1 11" \
    "console c 5 1" \
    "tty    c 5 0" \
    "tty0   c 4 0" \
    "ttyS0  c 4 64"
do
    set -- $node
    [ -e "/dev/$1" ] || mknod "/dev/$1" "$2" "$3" "$4" 2>/dev/null || true
done
